const int SENSOR_PIN = 3;
const int TRIG_PIN = 5;
const int OUTPUT_PIN = 7;
void setup() {
  // put your setup code here, to run once:
  Serial.begin(115200);
  pinMode(SENSOR_PIN, INPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(OUTPUT_PIN, OUTPUT);


  digitalWrite(TRIG_PIN, LOW);
}

void loop() {
  // put your main code here, to run repeatedly:
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  // 2. Measure the width of the echo pulse (in microseconds)
  long duration = pulseIn(SENSOR_PIN, HIGH);

  // 3. Calculate distance in centimeters (Speed of sound is ~340m/s)
  float distance = duration * 0.034 / 2;

  // Print distance for debugging (0 means out of range)
  if (duration > 0) {
    Serial.print("Distance: ");
    Serial.print(distance);
    Serial.println(" cm");
  }
  // 4. Trigger output if an object is closer than the threshold
  if (distance > 0 && distance <= 20) {
    Serial.println("Object detected! Activating Output.");
    digitalWrite(OUTPUT_PIN, HIGH);
    delay(1000); // Keep motor active for 1 second
  } else {
    digitalWrite(OUTPUT_PIN, LOW);
  }
  
  delay(50);

}
